
POSTGRES_DB=ai_bap
POSTGRES_USER=ai_bap_user
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_PORT=5433
# Managed providers can supply DATABASE_URL instead of the individual POSTGRES_* values.
# DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET_KEY=replace_with_a_local_secret_of_at_least_32_characters
# CORS_ORIGINS=["https://frontend.example"]
API_PORT=8000
FRONTEND_PORT=8080
# Only an empty public schema is initialized automatically by the Compose migrate service.
AI_BAP_INITIALIZE_FRESH_DATABASE=true
DEMO_ACCESS_TOKEN=replace_with_a_strong_random_demo_token
